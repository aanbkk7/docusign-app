# Database — a Postgres connection string. A free one from https://neon.tech
# works for both local dev and production; same string shape either way.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Required. Gates every sender-facing page/API (document list, prepare,
# send, delete, download) behind this one shared password — pick anything.
# Recipients never need it: their /sign/:token link is their only "login".
SENDER_PASSWORD="choose-a-strong-password"

# Required. Cloudflare R2 (S3-compatible object storage) — uploaded and
# signed PDFs live here, never on local disk (which is ephemeral on most
# hosts, including Render's free tier — it gets wiped on every restart).
# https://dash.cloudflare.com -> R2 -> create a bucket + API token.
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="docusign-app-files"

# The public URL recipients' signing links should point to. Required in
# production (takes priority over anything the client sends) — leave unset
# locally to keep using the LAN-IP / ngrok picker in the Send page.
# PUBLIC_APP_URL="https://your-app.onrender.com"

# Email configuration (optional — needed only for email sending)
# Use Gmail: enable 2FA → https://myaccount.google.com/apppasswords → create App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password

# SMS configuration (optional — needed only for SMS sending via Twilio)
# https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_FROM_NUMBER=+15551234567
