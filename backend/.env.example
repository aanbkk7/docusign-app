# Database — SQLite by default (zero config). Swap to a real Postgres URL in
# production; the schema and every query work unchanged against either.
DATABASE_URL="file:./dev.db"

# Email configuration (optional — needed only for email sending)
# Use Gmail: enable 2FA → https://myaccount.google.com/apppasswords → create App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password

# SMS configuration (optional — needed only for SMS sending via Twilio)
# https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_FROM_NUMBER=+15551234567
